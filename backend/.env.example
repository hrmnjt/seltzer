# Copy to backend/.env for local development.
SELTZER_ENV=local
PGHOST=localhost
PGUSER=seltzer
PGPASSWORD=seltzer
PGDATABASE=seltzer
# Who you are locally (the Databricks Apps proxy sets this in the workspace).
SELTZER_DEV_USER_EMAIL=you@example.com
# Local stand-in for membership of SELTZER_OWNER_GROUP.
SELTZER_DEV_OWNER_EMAILS=you@example.com
